SELECT livros.titulo, autores.nome AS autor
FROM livros
JOIN autores ON livros.id_autor = autores.id_autor;

SELECT 
    e.id_emprestimo,
    l.titulo,
    u.nome AS usuario,
    e.data_emprestimo,
    e.data_devolucao
FROM emprestimos e
JOIN livros l ON e.id_livro = l.id_livro
JOIN usuarios u ON e.id_usuario = u.id_usuario;

