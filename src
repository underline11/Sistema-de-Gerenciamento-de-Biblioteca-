CREATE VIEW vw_livros_emprestados AS
SELECT 
    l.titulo,
    u.nome AS usuario,
    e.data_emprestimo
FROM emprestimos e
JOIN livros l ON e.id_livro = l.id_livro
JOIN usuarios u ON e.id_usuario = u.id_usuario
WHERE e.data_devolucao IS NULL;

SELECT * FROM vw_livros_emprestados;

DELIMITER $$

CREATE FUNCTION contar_livros_autor(autor_id INT)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE total INT;
    SELECT COUNT(*) INTO total FROM livros WHERE id_autor = autor_id;
    RETURN total;
END $$

DELIMITER ;

